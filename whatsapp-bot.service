[Unit]
Description=WhatsApp Auto-Reply Bot
Documentation=https://github.com/santanu-p/whatsapp-reply-bot
After=network.target

[Service]
Type=simple
User=whatsappbot
Group=whatsappbot
WorkingDirectory=/opt/whatsapp-reply-bot
ExecStart=/usr/bin/node /opt/whatsapp-reply-bot/index.js
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=whatsapp-bot

# Environment
Environment=NODE_ENV=production
EnvironmentFile=/opt/whatsapp-reply-bot/.env

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/whatsapp-reply-bot/.wwebjs_auth

# Resource limits
LimitNOFILE=65536
MemoryMax=512M
CPUQuota=100%

[Install]
WantedBy=multi-user.target
